<main class="list-page">
  <div class="container">
    <header class="list-header">
      <div>
        <p class="eyebrow"><%= currentPath.startsWith('/tag/') ? '标签' : currentPath.startsWith('/category/') ? '分类' : '搜索' %></p>
        <h1><%= title %></h1>
        <p class="list-subtitle"><%= subtitle %></p>
      </div>
      <% if (typeof q !== 'undefined' && q) { %>
        <a class="text-link" href="/search/">清空搜索 <i data-lucide="x"></i></a>
      <% } %>
    </header>

    <div class="home-layout">
      <section class="main-col">
        <% if (items.length) { %>
          <div class="post-grid">
            <% items.forEach(function(p) { %>
              <%- include('partials/card', { post: p }) %>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state">
            <i data-lucide="search-x"></i>
            <p><%= emptyText %></p>
          </div>
        <% } %>
      </section>

      <aside class="sidebar">
        <%- include('partials/ad', { slot: 'list-side-top' }) %>
        <section class="side-card">
          <h2><i data-lucide="folder"></i> 全部分类</h2>
          <div class="category-list">
            <% categories.forEach(function(c) { %>
              <a href="/category/<%= c.slug %>/">
                <span><%= c.name %></span>
                <span class="count"><%= c.count %></span>
              </a>
            <% }) %>
          </div>
        </section>
        <section class="side-card">
          <h2><i data-lucide="tag"></i> 热门标签</h2>
          <div class="tag-cloud">
            <% tags.slice(0, 16).forEach(function(t) { %>
              <a href="/tag/<%= t.slug %>/"><%= t.name %></a>
            <% }) %>
          </div>
        </section>
        <%- include('partials/ad', { slot: 'list-side-bottom' }) %>
      </aside>
    </div>
  </div>
</main>
