{
  "name": "ai-tides",
  "version": "1.0.0",
  "private": true,
  "description": "AI 潮汐：AI 资讯自动博客 + AI 工具库，服务端渲染 + 发布 API + 广告位",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node lib/store.js --seed-only",
    "push": "node scripts/example-push.js",
    "build:static": "node scripts/export-static.js",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package.ps1",
    "bot:preview": "node scripts/xiaolongxia-worker.js --preview",
    "bot:push": "node scripts/xiaolongxia-worker.js --push",
    "bot:daemon": "node scripts/xiaolongxia-worker.js --daemon",
    "bot:template": "node scripts/xiaolongxia-worker.js --push --allow-template --limit=1"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
