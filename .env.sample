# 仅在本机运行 scripts/xiaolongxia-worker.js 时使用。
# Cloudflare Pages 部署后站点不需要这些变量，后台配置直接在 /admin 完成。
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME=AI 潮汐
SITE_TAGLINE=实时追踪 AI 热点，不错过每一个值得关注的新变化

# 收录申请表单 mailto 的接收邮箱（覆盖 /contact 页面显示的站方邮箱）
CONTACT_EMAIL=1534838732@qq.com

# 收录申请邮件推送（Cloudflare 无法直接发 SMTP，需要选一个邮件服务）
# 推荐 Resend：登录 https://resend.com 创建一个 API Key，填到 RESEND_API_KEY
# 未配置时申请仍会完整保存在 /admin 后台的“合作收录申请”，不会丢失
RESEND_API_KEY=
# 可选：发件地址（Resend 免费域名必须用 onboarding@resend.dev 或已认证域名）
EMAIL_FROM=
# 备用：Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# “小龙虾”或其他自动化机器人调用发布 API 时使用的密钥
# 不需要自己生成：部署后打开 /admin 后台设置管理密码并登录，然后在后台创建 API 密钥
# 把创建时显示一次的完整 ait_... 字符串粘贴到等号后面
XIAOLONGXIA_API_KEY=

# “小龙虾”侧内容生成用的国内云厂商 OpenAI 兼容模型（仅本地 worker 读取，站点不读取）
# 例：阿里云百炼 / 火山引擎豆包 / DeepSeek / 智谱，按所选厂商填
OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-your-model-key
MODEL_NAME=qwen-plus

# “小龙虾”自动发文定时（worker 侧读取）：早 10:00、下午 17:00，每天 2 篇
XIAOLONGXIA_TIMES=10:00,17:00
XIAOLONGXIA_MAX_PER_RUN=1
XIAOLONGXIA_TIMEZONE=Asia/Shanghai

# Google AdSense：填写后页面才会渲染真实广告代码
ADSENSE_CLIENT=ca-pub-4951997546216729
ADSENSE_SLOT_SIDEBAR_TOP=
ADSENSE_SLOT_SIDEBAR_BOTTOM=
ADSENSE_SLOT_ARTICLE_TOP=
ADSENSE_SLOT_ARTICLE_MIDDLE=
ADSENSE_SLOT_ARTICLE_SIDE_TOP=
ADSENSE_SLOT_ARTICLE_SIDE_BOTTOM=
ADSENSE_SLOT_LIST_SIDE_TOP=
ADSENSE_SLOT_LIST_SIDE_BOTTOM=

# 上线时覆盖 ads.txt 内容
ADS_TXT=google.com, pub-4951997546216729, DIRECT, f08c47fec0942fa0
